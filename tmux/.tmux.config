##### PREFIX ###############################################################

# Use Ctrl+s instead of Ctrl+b.
unbind C-b
set -g prefix C-s
bind C-s send-prefix

##### GENERAL ##############################################################

# Enable mouse support.
set -g mouse on

# Keep a long scrollback history.
set -g history-limit 100000

# Better responsiveness.
set -sg escape-time 0
set -g focus-events on

# Use system clipboard.
set -g set-clipboard on

# Number windows/panes starting from 1.
set -g base-index 1
setw -g pane-base-index 1

# Renumber windows automatically after one is closed.
set -g renumber-windows on

##### RELOAD ###############################################################

# Reload tmux config.
bind r source-file ~/.tmux.conf \; display-message "tmux config reloaded"

##### WINDOWS ##############################################################

# Create new window in current working directory.
bind c new-window -c "#{pane_current_path}"

##### PANES ################################################################

# Split panes in current working directory.
unbind %
unbind '"'

bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# Vim-style pane navigation.
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Resize panes.
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

##### POPUPS ###############################################################

# Lazygit popup.
bind g display-popup \
    -E \
    -w 90% \
    -h 90% \
    -d "#{pane_current_path}" \
    "lazygit"

# Sessionizer (implemented on Day 2).
bind f display-popup \
    -E \
    -w 80% \
    -h 80% \
    "$HOME/.local/bin/tmux-sessionizer"

##### PLUGINS ##############################################################

set -g @plugin "tmux-plugins/tpm"

set -g @plugin "tmux-plugins/tmux-resurrect"

set -g @plugin "tmux-plugins/tmux-continuum"

##### RESURRECT ############################################################

# Save pane contents.
set -g @resurrect-capture-pane-contents "on"

##### CONTINUUM ############################################################

# Automatically restore tmux after reboot.
set -g @continuum-restore "on"

# Auto-save every 15 minutes.
set -g @continuum-save-interval "15"

##### TPM ##################################################################

# Keep this at the bottom.
run "~/.tmux/plugins/tpm/tpm"
